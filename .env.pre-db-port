# Redis Cloud Configuration
# Switched to local Docker Redis. Remote credential below is in git history and should be rotated.
# REDIS_URL=redis://default:gIl3owPoeJpneYZTmMQOYkw82jwfpEYr@gold-letter-velvet-61093.db.redis.io:13958
REDIS_URL=redis://localhost:6380

# Real-time Stream Engine
MARKET_STREAM_TRACKED_MINTS=So11111111111111111111111111111111111111112
MARKET_STREAM_ENABLED=true
# Parsed-transaction enrichment (recovers mint/amount/side that
# logsSubscribe cannot provide). Defaults suit a free Helius plan;
# raise RPS to capture a larger share of mainnet swaps.
HELIUS_ENRICH_RPS=1
# 0 = do not clamp the rate to a monthly budget (1 call/s chosen
# deliberately). Set this to the plan allowance to have the
# enricher pace itself to last the month instead.
HELIUS_ENRICH_MONTHLY_CREDITS=0
HELIUS_ENRICH_HOURS_PER_DAY=24
HELIUS_ENRICH_CONCURRENCY=4
HELIUS_ENRICH_QUEUE=5000
# Scheduled token refresh (spawns db/discover-tokens.js and
# db/backfill-token-enrichment.js on a timer). Off by default so it
# never starts spending API calls unannounced.
TOKEN_REFRESH_ENABLED=true
TOKEN_REFRESH_PRICE_MS=300000
TOKEN_REFRESH_DISCOVERY_MS=1800000

HELIUS_ENRICH_BATCH=1

