# ==============================================================================
# Project Sentinel — Environment Variable Template
# NOTE: Use placeholders only. Never commit production secrets.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=3000
WS_PORT=3000
HOSTNAME=localhost

# Frontend API Configuration
NEXT_PUBLIC_API_VERSION=v1
NEXT_PUBLIC_API_URL=http://localhost:3000

# Solana Network Configuration
NEXT_PUBLIC_SOLANA_NETWORK=solana:devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
NEXT_PUBLIC_USDC_MINT_ADDRESS=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# Helius LaserStream & WebSocket RPC Configuration
HELIUS_API_KEY=YOUR_HELIUS_API_KEY
HELIUS_GRPC_ENDPOINT=https://laserstream-devnet-ewr.helius-rpc.com
HELIUS_GRPC_TOKEN=YOUR_HELIUS_GRPC_TOKEN
HELIUS_WS_URL=wss://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_LASERSTREAM_URL=https://laserstream-devnet-ewr.helius-rpc.com

# Birdeye Market Data & WebSocket Configuration
BIRDEYE_API_KEY=YOUR_BIRDEYE_API_KEY
BIRDEYE_WS_URL=wss://public-api.birdeye.so/socket/solana

# Redis Cache & Real-Time Event Bus Configuration
REDIS_URL=redis://default:YOUR_REDIS_PASSWORD@YOUR_REDIS_HOST:YOUR_REDIS_PORT

# PostgreSQL Database Configuration
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/postgres

# Authentication & Security
AUTH_JWT_SECRET=YOUR_256_BIT_SECRET_KEY
LOG_LEVEL=debug

# Real-Time Stream Engine
MARKET_STREAM_ENABLED=true
MARKET_STREAM_TRACKED_MINTS=So11111111111111111111111111111111111111112
MOCK_REALTIME=false
