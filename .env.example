# ---------------------------------------------------------------------------
# Project Sentinel — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored; this file must only ever
# contain placeholders. Never commit a real key here or in source: a Redis
# credential was previously hardcoded as a default in `lib/server/env.ts` and
# is now in git history permanently.
#
# Everything below is server-only. None of it is exposed to the browser —
# anything the browser needs must be prefixed NEXT_PUBLIC_ and must never be
# a secret.
# ---------------------------------------------------------------------------

NODE_ENV=development

# --- Database (required) ---------------------------------------------------
# Local dev via `docker compose up -d db` (host port 5433, not 5432, because
# 5432 is commonly taken by another project).
DATABASE_URL=postgresql://sentinel:sentinel@localhost:5433/sentinel

# --- Redis (optional; real-time event bus) ---------------------------------
# `docker compose up -d redis` (host port 6380, same reasoning as above).
# Leave EMPTY to run without Redis: the event bus degrades to in-process
# delivery, which is correct for a single instance but gives no cross-instance
# fan-out and no cross-process deduplication.
REDIS_URL=redis://localhost:6380

# --- Auth (required) -------------------------------------------------------
# Without this, a random per-process secret is generated and every session is
# invalidated on restart. Required in production — the app refuses to sign
# tokens without it.
AUTH_JWT_SECRET=

# --- Helius (blockchain events) --------------------------------------------
HELIUS_API_KEY=
# Server-only RPC used to broadcast signed user transactions. Set this to a
# mainnet Helius RPC URL before enabling production trading.
HELIUS_RPC_URL=
# Manual wallet-approved Jupiter swaps (Solana mainnet). No bot/automatic signing.
# If dedicated URLs are empty, the server uses HELIUS_RPC_URL, then HELIUS_API_KEY.
# Both primary and optional fallback must pass a mainnet genesis-hash check.
SOLANA_TRADING_ENABLED=false
SOLANA_TRADING_RPC_URL=
SOLANA_TRADING_FALLBACK_RPC_URL=
# Optional: uses authenticated api.jup.ag when present; otherwise the existing lite API.
JUPITER_API_KEY=
HELIUS_WS_URL=wss://mainnet.helius-rpc.com
# --- QuickNode (optional mainnet RPC/WebSocket redundancy) -------------------
# Copy the corresponding HTTPS and WSS endpoints from the same QuickNode
# Solana mainnet endpoint. Keep authentication in these server-only variables.
# QuickNode is used only for low-level chain reads / Helius stream failover;
# Birdeye remains the market/analytics source. Leave empty to disable.
QUICKNODE_SOLANA_RPC_URL=
QUICKNODE_SOLANA_WSS_URL=
# gRPC/LaserStream endpoint. Only used once a real Yellowstone gRPC client is
# implemented — the previous "LaserStream client" was a health-ping stub and
# has been removed. Current ingestion is `logsSubscribe` over HELIUS_WS_URL.
HELIUS_GRPC_URL=
HELIUS_GRPC_TOKEN=

# --- Birdeye (market-data enrichment) --------------------------------------
BIRDEYE_API_KEY=
BIRDEYE_WS_URL=wss://public-api.birdeye.so/socket/solana

# Optional ownership and wallet-PnL fallback when Birdeye access is limited.
# Server-only; obtain a Data API key from Solana Tracker. Never use NEXT_PUBLIC_ here.
SOLANA_TRACKER_API_KEY=

# --- Real-time stream control ----------------------------------------------
# Master switch for outbound Helius/Birdeye connections. Left FALSE by default
# so a clone of this repo does not start burning paid API quota on boot.
# Set true to ingest live chain data.
MARKET_STREAM_ENABLED=false

# Comma-separated. Empty means "use the built-in defaults".
MARKET_STREAM_TRACKED_MINTS=
MARKET_STREAM_PROGRAM_IDS=

# Emits synthetic events so the frontend real-time path can be developed
# without touching Helius or Birdeye. MUST stay false in production.
MOCK_REALTIME=false

# --- WebSocket -------------------------------------------------------------
# The app serves /ws from its own HTTP server (server.js), so this is only
# needed if the WS server is split onto a separate port.
WS_PORT=8080

# Set when the browser must reach a WebSocket on a different host than the
# page. Public by definition — never put a secret here.
NEXT_PUBLIC_WS_URL=

# --- Demo mode -------------------------------------------------------------
# Seeds the wallet store with fabricated wallets and a signed-in identity, for
# screenshots and demos. OFF by default: it used to be unconditional, which made
# the app look authenticated as a user who did not exist and sent a hardcoded
# (and invalid) wallet address to every wallet-scoped endpoint.
NEXT_PUBLIC_DEMO_MODE=false
